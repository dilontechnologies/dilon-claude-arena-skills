# Copy this file to `.env` and fill in your values.
# `.env` should NEVER be shared or committed to git.
#
# NOTE: If you run Install-ArenaMCP.ps1, it creates this .env for you
# from the three values it prompts for — you don't need to edit this by hand.

# --- Required ---

# From Arena: Workspace Settings -> OAuth Applications -> your parent app
# -> Client Credentials section -> the row tied to YOUR user.
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=

# The Arena workspace ID this server should operate against.
# Find it in the Arena URL while in a workspace, or in Workspace Settings.
ARENA_WORKSPACE_ID=

# --- Optional (defaults shown) ---

# Override only if Arena tells you to use a different host.
# ARENA_TOKEN_URL=https://oauth.bom.com/oauth2/token
# ARENA_API_BASE=https://api.arenasolutions.com/v1

# Free-form label that appears in Arena's audit/usage logs.
# Recommended format: <company> <integration> / <your name>
# ARENA_USAGE_REASON=<company> Claude / <your name>

# --- Multiple environments (optional) ---
#
# To switch between more than one workspace (e.g. production + a sandbox)
# without re-entering credentials each time: copy environments.example.json
# to environments.local.json (never committed) next to arena_mcp_server.py,
# fill in each environment's real values, then set which one is active here:
# ARENA_ENVIRONMENT=production
